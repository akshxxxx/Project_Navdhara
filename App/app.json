{
  "expo": {
    "name": "Raah",
    "slug": "raah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.raah.nh7"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B2A33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.raah.nh7",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Raah · NH-7",
      "themeColor": "#1B2A33"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#1B2A33"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Raah uses your location to place your road report on NH-7."
        }
      ]
    ],
    "scheme": "raah",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f06861a3-b6aa-42c6-be81-8f2f89583afe"
      }
    }
  }
}
