# NH-7 Landslide Early Warning Backend Environment Configuration
# ================================================================

# --- Core Server & Environment Settings ---
# Environment mode: 'development' or 'production'
ENV=development

# Server Host and Port binding
HOST=0.0.0.0
PORT=8000

# Base URL for smoke tests and client testing
BASE_URL=http://127.0.0.1:8000

# Admin API Key for authenticated endpoints (/admin/closure, /admin/validate-report)
ADMIN_API_KEY=admin-dev-secret-key-nh7

# Allowed CORS Origins (comma-separated, e.g. https://myfrontend.com, http://localhost:3000)
# In development, defaults to *
CORS_ORIGINS=*

# --- Feature Flags ---
# Background scheduler for periodic weather polling and alert evaluation
ENABLE_SCHEDULER=true
WEATHER_POLL_MINUTES=30

# Weather Engine Mode:
# false: Default hardened 5-station daily assimilation with 4-tier resilience & snapshots
# true: Advanced 18-segment hourly forecast & peak detection engine
PER_SEGMENT_WEATHER=false

# Feature 2: Historical Time Machine & Backtest harness replay
# Keep true: the web dashboard and the app both use the time machine (as_of)
BACKTEST_ENABLED=true

# Feature 3: Time-aware forecast-based trip planning
TIME_AWARE_PLANNER=true
DEFAULT_SPEED_KMPH=30.0

# Feature 5: Ground-truth field report flywheel layer
GROUND_TRUTH_LAYER=true
GROUND_REPORT_HALF_LIFE_HOURS=48.0
GROUND_REPORT_ESCALATE_THRESHOLD=0.75
GROUND_REPORT_MAX_ESCALATION_STEPS=1

# Demo Mode: Pins weather to local snapshot so demonstrations never depend on live internet
DEMO_MODE=false
# Optional Open-Meteo paid-plan key. Empty = free plan (10,000 calls a day per internet connection;
# one 18-stretch refresh counts as 18). With a key, requests go to customer-api.open-meteo.com.
OPEN_METEO_API_KEY=

# --- Task 6: Messaging & Alert Dispatcher Configuration ---
# Safe Mode: If true, logs dispatch messages to console without calling external APIs
DRY_RUN=true

# Twilio SMS Credentials (Optional for live SMS delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Note: TWILIO_PHONE_NUMBER is also supported as a backwards-compatible alias for TWILIO_FROM

# Telegram Bot Credentials (Optional for live bot polling)
TELEGRAM_BOT_TOKEN=
ENABLE_TELEGRAM_BOT=false

# Alert Dispatcher Polling Interval (in minutes; default: 10)
ALERT_DISPATCH_INTERVAL_MINUTES=10
# Note: ALERT_CHECK_INTERVAL (in seconds) is also supported as a backwards-compatible alias
ALERT_COOLDOWN_HOURS=3.0

# --- Raah Node (ESP32 slope sensor) ---
# Shared secret: the firmware sends it as X-Node-Key. Put the SAME string in the sketch's NODE_KEY.
# Unset -> POST /node/reading answers 503 ("NET,POST_FAIL,503" on the node).
NODE_API_KEY=change-me-long-random-string
# Silent this many seconds -> STALE, or SENSOR_LOST if the last state was WARNING/ALARM
NODE_STALE_S=15
# Silent this many seconds while calm -> OFFLINE
NODE_OFFLINE_S=120
# A reading whose NTP-valid ts_ms is older than this is filed as history only
NODE_LATE_S=15
# A mark this recent before an incident opens is linked to it (one-clock timing)
NODE_MARK_WINDOW_S=180
# USB link: "auto" = read any ESP32 plugged into this laptop, "COM5" = that port only, "off" = Wi-Fi only
NODE_SERIAL=auto
NODE_SERIAL_BAUD=115200
# Used when a USB line has no node_id / segment_id
NODE_SERIAL_NODE_ID=NODE1
NODE_SERIAL_SEGMENT=seg_05
# Bench calibration of the LM393 boards (raw ADC, used only when the node sends soil_raw / rain_raw)
NODE_SOIL_DRY_RAW=4095
NODE_SOIL_WET_RAW=1250
NODE_RAIN_DRY_RAW=4095
NODE_RAIN_WET_RAW=2400
NODE_RAIN_WET_PCT=50

# --- Task 8: Offline Pack & Emergency Contacts ---
# JSON string of emergency contact dictionaries (optional override)
# EMERGENCY_CONTACTS=[{"name":"National Emergency Helpline","number":"112"}]
OFFLINE_PACK_SIMPLIFY_TOLERANCE=0.0005
